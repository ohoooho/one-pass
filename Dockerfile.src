# syntax=docker/dockerfile:1.7
# One-pass production image — alpine-based, built from Go source.
#
# Use this Dockerfile when you need to recompile the server from source.
# Requires network access to a Go module proxy.
#
# Build: docker build -f Dockerfile.src -t ohoooho/one-pass:dev-src .

FROM golang:bookworm AS app-src
RUN mkdir -p /onepass
WORKDIR /onepass
COPY . .
ARG VERSION
RUN VERSION=${VERSION:-$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")} && \
    go build ./cmd/onepass && \
    go build -ldflags "-X main.version=${VERSION}" ./cmd/onepass-server

FROM node:22-alpine AS website
COPY website /website
WORKDIR /website
RUN yarn install --network-timeout 600000 && yarn build

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -g 1000 onepass && \
    adduser -D -G onepass -u 1000 onepass
COPY --from=app-src /onepass/onepass-server /onepass-server
COPY --from=website /website/dist /public
USER onepass
EXPOSE 1337
ENTRYPOINT ["/onepass-server"]
